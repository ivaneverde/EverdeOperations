<?xml version="1.0" encoding="UTF-16"?>
<!--
  Prefer: npm run weekly:register-tasks  (registers Everde-WCRO-WeeklyCheck Mon 11:00)

  This XML is a fallback import if you need a standalone task:
    schtasks /Create /XML Everde-WCRO-WeeklyExtract.xml /TN "Everde-WCRO-WeeklyCheck" /F

  Adjust WorkingDirectory to your local clone path.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2026-08-07T00:00:00</Date>
    <Author>Everde Operations</Author>
    <Description>Monday 11:00 AM — WCRO WeeklyDrop extract + Blob publish for portal and Teams bots.</Description>
    <URI>\Everde-WCRO-WeeklyCheck</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-08-11T11:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek><Monday /></DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "C:\Users\isunderland\everde-ai-operations\scripts\windows\run-scheduled-wcro.ps1"</Arguments>
      <WorkingDirectory>C:\Users\isunderland\everde-ai-operations</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
