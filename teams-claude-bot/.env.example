# Microsoft Bot Framework (Azure Bot / Entra app registration) — Claude (full)
MicrosoftAppId=
MicrosoftAppPassword=
# Recommended for Everde internal use:
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=

# Optional — Everde HD key-account bot (separate Entra + Azure Bot → /api/messages/hd)
# MicrosoftAppIdHd=
# MicrosoftAppPasswordHd=

# Optional — Everde Lowes key-account bot (separate Entra + Azure Bot → /api/messages/lowes)
# MicrosoftAppIdLowes=
# MicrosoftAppPasswordLowes=

# Server
PORT=3978

# Anthropic Claude
ANTHROPIC_API_KEY=
# Recommended (matches Claude.ai / Desktop default tier as of Oct 2026):
#   claude-sonnet-5-5  — best quality/cost for Teams ops Q&A (~$2/$10 per MTok)
# Premium (harder multi-step reasoning; ~2× Sonnet 5.5 cost, higher latency):
#   claude-opus-5-5    — ~$4/$20 per MTok
# Legacy (still works; Anthropic recommends migrating off):
#   claude-sonnet-4-6  — ~$3/$15 per MTok
CLAUDE_MODEL=claude-sonnet-5-5
# Output budget per Claude round (schema max 8192). 4096 is enough for most Teams replies;
# raise to 8192 if answers truncate mid-tool-summary.
CLAUDE_MAX_TOKENS=4096
# Prompt caching (default on). Same answers; cheaper/faster on follow-ups + tool rounds.
# Set CLAUDE_PROMPT_CACHING=0 to disable without a redeploy of code.
# CLAUDE_PROMPT_CACHING=1

# Conversation memory (messages per user thread in Teams)
CONVERSATION_MAX_TURNS=20

# File attachments (Teams → Claude)
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_EXCEL_ROWS=10000
CONVERSATION_FILE_MAX_CHARS_PER_FILE=2000000
CONVERSATION_FILE_MAX_TOTAL_CHARS=4000000
EVERDE_RETAIL_TOOL_MAX_CHARS=120000

# Everde portal data (Azure Blob — same connection as AI Operations portal)
AZURE_STORAGE_CONNECTION_STRING=

# Web search: on-demand only. Key-account bots (HD / Lowes) disable web search in code.
ENABLE_WEB_SEARCH=1
