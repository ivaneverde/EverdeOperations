# Microsoft Bot Framework (Azure Bot / Entra app registration) — Claude (full)
MicrosoftAppId=
MicrosoftAppPassword=
# Recommended for Everde internal use:
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=

# Optional — Everde HD key-account bot (separate Entra + Azure Bot → /api/messages/hd)
# MicrosoftAppIdHd=
# MicrosoftAppPasswordHd=

# Optional — Everde Lowes key-account bot (separate Entra + Azure Bot → /api/messages/lowes)
# MicrosoftAppIdLowes=
# MicrosoftAppPasswordLowes=

# Server
PORT=3978

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# Conversation memory (messages per user thread in Teams)
CONVERSATION_MAX_TURNS=20

# File attachments (Teams → Claude)
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_EXCEL_ROWS=10000
CONVERSATION_FILE_MAX_CHARS_PER_FILE=2000000
CONVERSATION_FILE_MAX_TOTAL_CHARS=4000000
EVERDE_RETAIL_TOOL_MAX_CHARS=120000

# Everde portal data (Azure Blob — same connection as AI Operations portal)
AZURE_STORAGE_CONNECTION_STRING=

# Web search: on-demand only. Key-account bots (HD / Lowes) disable web search in code.
ENABLE_WEB_SEARCH=1
